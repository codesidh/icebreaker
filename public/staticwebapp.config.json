{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "routes": [
    {
      "route": "/_next/static/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/_next/*", "/*.{js,css,json,svg,png,ico,txt,woff,woff2}"]
  }
}
